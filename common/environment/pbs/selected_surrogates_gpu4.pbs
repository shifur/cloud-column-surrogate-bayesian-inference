#!/usr/bin/env bash
#PBS -N cloud_selected_surrogates
#PBS -l select=1:ncpus=64:ngpus=4
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

module --force purge
module load ncarenv/24.12
module load gcc/12.4.0
module load cuda/12.3.2
module load conda/latest
module list

export TMPDIR="${CLOUD_COLUMN_JOB_TMPDIR:-${TMPDIR:-/tmp}/cloud-column-study/${PBS_JOBID:-manual}}"
export PIP_CACHE_DIR="${WORK}/pip-cache"
export CUBLAS_WORKSPACE_CONFIG=:4096:8
mkdir -p "${TMPDIR}" "${PIP_CACHE_DIR}"

: "${STAGE:?STAGE is required}"

cd "${PBS_O_WORKDIR}"

pids=()

for case_index in 0 1; do
    echo "SELECTED_SURROGATE_START index=${case_index} physical_gpu=${case_index}"
    case_tmp="${TMPDIR}/selected_surrogate_${case_index}"
    mkdir -p "${case_tmp}"
    TMPDIR="${case_tmp}" CUDA_VISIBLE_DEVICES="${case_index}" \
      conda run --no-capture-output -n cloud-column-study-derecho \
      python -u scripts/run_study.py run-stage \
      --stage "${STAGE}" --index "${case_index}" &
    pids+=("$!")
done

status=0
for pid in "${pids[@]}"; do
    if ! wait "${pid}"; then
        status=1
    fi
done

if (( status != 0 )); then
    echo "One or more selected-surrogate processes failed" >&2
    exit 1
fi

echo "SELECTED_SURROGATES_COMPLETE"
