#!/usr/bin/env bash
#PBS -N cloud_candidate_diag
#PBS -l select=1:ncpus=128:mpiprocs=1
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

module --force purge
module load ncarenv/24.12
module load gcc/12.4.0
module load conda/latest
module list

export TMPDIR="${CLOUD_COLUMN_JOB_TMPDIR:-${TMPDIR:-/tmp}/cloud-column-study/${PBS_JOBID:-manual}}"
export PIP_CACHE_DIR="${WORK}/pip-cache"
mkdir -p "${TMPDIR}" "${PIP_CACHE_DIR}"

: "${STAGE:?STAGE is required}"
: "${PBS_ARRAY_INDEX:?PBS_ARRAY_INDEX is required}"

cd "${PBS_O_WORKDIR}"

base_trial=$((PBS_ARRAY_INDEX * 4))
pids=()

for local_index in 0 1 2 3; do
    trial=$((base_trial + local_index))
    echo "CANDIDATE_DIAGNOSTIC_START trial=${trial}"

    trial_tmp="${TMPDIR}/candidate_diagnostic_${trial}"
    mkdir -p "${trial_tmp}"

    TMPDIR="${trial_tmp}" \
      conda run --no-capture-output -n cloud-column-study-derecho \
      python -u scripts/run_study.py run-stage \
      --stage "${STAGE}" --index "${trial}" &
    pids+=("$!")
done

status=0
for pid in "${pids[@]}"; do
    if ! wait "${pid}"; then
        status=1
    fi
done

if (( status != 0 )); then
    echo "One or more candidate diagnostic processes failed" >&2
    exit 1
fi

echo "CANDIDATE_DIAGNOSTICS_COMPLETE array_index=${PBS_ARRAY_INDEX}"
